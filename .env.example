# Mitti2Market Environment Configuration

# Server Port
PORT=3000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/mitti2market

# JWT Secret Key for token signing and verification
JWT_SECRET=mitti2market_jwt_secret_super_secure_key_2026

# Token expiration period
JWT_EXPIRES_IN=7d

# Optional Agmarknet / data.gov.in API key for live UP Mandi real-time sync
# (Server automatically uses pre-loaded certified UP mandi database if key is not configured)
DATA_GOV_IN_API_KEY=

# Transport Cost Calculation Engine Defaults
# Default freight charge per kilometer per quintal in INR (₹)
DEFAULT_FREIGHT_RATE_PER_KM_QUINTAL=2.5

# Loading and unloading handling charge per quintal in INR (₹)
DEFAULT_HANDLING_CHARGE_PER_QUINTAL=25

# APMC Mandi cess / market development fee percentage (e.g., 1.5%)
DEFAULT_MANDI_CESS_PERCENT=1.5

# CORS allowed origin
CORS_ORIGIN=*

# Gemini API Key (if AI Studio uses server side features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Studio App Host URL
APP_URL="MY_APP_URL"
