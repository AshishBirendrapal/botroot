PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/krishilink
JWT_SECRET=change_this_secret
CLIENT_URL=http://localhost:5173

# data.gov.in key: https://data.gov.in -> Register -> My Account -> API key
DATA_GOV_API_KEY=your_data_gov_key
# Google Cloud Console -> enable "Distance Matrix API"
GOOGLE_MAPS_API_KEY=your_google_key

# true = dummy mandi + distance data (bina API key ke test karne ke liye)
USE_MOCK=true

# Transport cost in Rs per quintal per km
TRANSPORT_RATE_PER_QTL_KM=0.4
